{
  "name": "cjit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "C/C++ Studio - a client-only C/C++ editor with live variable watch, deployed to GitHub Pages",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "toolchain": "node scripts/fetch-toolchain.mjs",
    "smoke:clang": "node scripts/clang-smoke.mjs"
  },
  "dependencies": {
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
